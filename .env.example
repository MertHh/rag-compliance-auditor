# Copy to .env and fill in. .env is git-ignored.
OPENAI_API_KEY=
# Optional: pin models; otherwise the newest gpt-N.N and gpt-N.N-mini in the account are used.
# OPENAI_EVAL_MODEL=gpt-5.5
# OPENAI_SMALL_MODEL=gpt-5.4-mini
# USD per 1M input/output tokens, for cost reporting: model=in/out,model=in/out
# OPENAI_PRICES=
AUDITOR_PROVIDER=openai
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# AUDIT_CONCURRENCY=4
# Storage and models (defaults shown)
# AUDITOR_DATA_DIR=data
# QDRANT_URL=            # empty = local on-disk Qdrant
# AUDITOR_COLLECTION=chunks
# EMBED_MODEL=BAAI/bge-m3
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# AUDITOR_DEVICE=        # empty = auto
# AUDITOR_PLAYBOOKS=playbooks
# AUDITOR_CONTEXT_PREFIX=0   # 1 = one LLM sentence of context per chunk before embedding (costs an LLM call per chunk)
# OLLAMA_NUM_CTX=16384
# OLLAMA_THINK=0           # qwen3 and other thinking models: 0 = answer directly (much faster)
# RERANK_DEVICE=cpu        # move the reranker off the GPU when a 14B model needs the memory

# API and UI
# AUDITOR_API_URL=http://localhost:8000
# AUDITOR_BENCHMARKS=benchmarks/results
